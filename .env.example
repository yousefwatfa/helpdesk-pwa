APP_NAME="Help Desk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Branding defaults. Admins can change name, colour and logo later from
# Settings (admin/settings); these are only used until then.
HELPDESK_NAME="نظام الدعم الفني"
HELPDESK_SHORT_NAME="الدعم الفني"
HELPDESK_ORGANIZATION=
HELPDESK_PRIMARY_COLOR="#0077C2"
# Where the uploaded logo/icons go under public/. Use storage/branding on
# containers (Railway) so they sit on the persistent storage volume.
HELPDESK_BRANDING_DIRECTORY=branding

# First root admin for `php artisan helpdesk:install --no-interaction` (deploys).
# Used only while no root admin exists; remove the password after first deploy.
HELPDESK_ADMIN_USERNAME=admin
HELPDESK_ADMIN_NAME="مدير النظام"
HELPDESK_ADMIN_PASSWORD=

# Optional LDAP / Active Directory sign-in. Local accounts always work;
# with LDAP_ENABLED=true, other users are checked against AD and created
# on their first sign-in.
LDAP_ENABLED=false
LDAP_HOST=
LDAP_PORT=389
LDAP_DOMAIN=example.com
LDAP_BASE_DN="DC=example,DC=com"
# Users whose DN contains this text keep the branches/office set by an admin
LDAP_PROTECTED_DN=

# Web push (PWA) - generate the keys with: php artisan webpush:vapid
# Push needs HTTPS (or localhost).
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional outbound proxy for push services
WEBPUSH_PROXY=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# "reverb" for live updates in the browser (run php artisan reverb:start), or "log" to turn them off
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
